# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local tooling (skills, not part of the site)
.claude/

# внутренние справочные материалы (бриф, семантическое ядро, исходники
# логотипов) — не для публичного репозитория, передаются отдельно
# (флешка/облако), см. materials/README.md
materials/*
!materials/README.md

# typescript
*.tsbuildinfo
next-env.d.ts

# локальный инструмент для правки текстов/фото клиентом — не часть
# сайта, открывается напрямую как файл, в репозиторий не идёт
Редактор сайта.html
zorin-site-edits-*.json

# личные рабочие файлы разработчика — не для клиентской копии, случайно
# не должны попасть в коммит при широком git add
Что сделано.md
Инструкция по передаче.md
